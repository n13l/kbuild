# Profile: perf — maximum throughput on a fixed modern CPU.
#
# Speed-optimized, acceleration fixed at build time to Apple M1
# with the crypto and SHA-3 instruction extensions; retune the
# ARM_CPU_* choice for other cores (note: SVE-capable server cores
# such as Neoverse V1/V2 let the compiler emit SVE, which faults on
# CPUs without SVE). No PIC, no stack protector, no debug/log/trace
# overhead.
# Apply on top of a defconfig: make defconfig perf.config
CONFIG_CC_OPTIMIZE=y
CONFIG_CC_OPTIMIZE_FOR_SPEED=y
# CONFIG_CC_CPU_ACCEL_RUNTIME is not set
CONFIG_CC_CPU_ACCEL_BUILDTIME=y
# CONFIG_ARM_CPU_GENERIC is not set
CONFIG_ARM_CPU_APPLE_M1=y
CONFIG_NEON=y
CONFIG_ARM_CRYPTO_EXTENSIONS=y
CONFIG_ARM_SHA3_EXTENSIONS=y
# CONFIG_CC_PIC is not set
CONFIG_CC_STACKPROTECTOR_NONE=y
CONFIG_CC_STRIP=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_LOGGING is not set
# CONFIG_TRACE is not set
# CONFIG_MEASURE is not set
