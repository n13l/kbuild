# Profile: perf-rt — low-latency / real-time variant of perf.
#
# Same build-time CPU tuning as perf, plus the lock-free runtime
# facilities: RCU read-side data structures and restartable sequences
# (per-CPU data access without atomics). DIT is enabled for
# data-independent timing of sensitive paths; CPU hotplug is disabled —
# RT deployments pin threads to isolated cores with a fixed topology.
# Apply on top of a defconfig: make defconfig perf-rt.config
CONFIG_CC_OPTIMIZE=y
CONFIG_CC_OPTIMIZE_FOR_SPEED=y
# CONFIG_CC_CPU_ACCEL_RUNTIME is not set
CONFIG_CC_CPU_ACCEL_BUILDTIME=y
# CONFIG_ARM_CPU_GENERIC is not set
CONFIG_ARM_CPU_APPLE_M1=y
CONFIG_NEON=y
CONFIG_ARM_CRYPTO_EXTENSIONS=y
CONFIG_ARM_SHA3_EXTENSIONS=y
CONFIG_ARM_DIT=y
CONFIG_CC_RCU=y
CONFIG_CC_RSEQ=y
# CONFIG_CC_PIC is not set
CONFIG_CC_STACKPROTECTOR_NONE=y
CONFIG_CC_STRIP=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_LOGGING is not set
# CONFIG_TRACE is not set
# CONFIG_HOTPLUG_CPU is not set
