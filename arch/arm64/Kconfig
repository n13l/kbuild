	select HAVE_EFFICIENT_UNALIGNED_ACCESS
	select HAVE_CC_STACKPROTECTOR
	select GENERIC_HWEIGHT
	select GENERIC_CALIBRATE_DELAY
	select SWIOTLB
	help
