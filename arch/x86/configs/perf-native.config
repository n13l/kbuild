# Profile: perf-native — maximum throughput, auto-tuned to the build host.
#
# Like perf, but instead of pinning a processor family it enables CPU_NATIVE:
# the cpucap tool detects the build host and auto-selects the matching entry in
# the "Processor family" choice, which pulls in that model's predefined
# capabilities (AVX / AVX2 / SHA-NI). The compiler is pointed at -march=native,
# so codegen is exact for this machine. The resulting binary is NOT portable to
# an older CPU — build it where you run it.
# Apply on top of a defconfig: make defconfig perf-native.config
CONFIG_CC_OPTIMIZE=y
CONFIG_CC_OPTIMIZE_FOR_SPEED=y
# CONFIG_CC_CPU_ACCEL_RUNTIME is not set
CONFIG_CC_CPU_ACCEL_BUILDTIME=y
CONFIG_CPU_NATIVE=y
# CONFIG_GENERIC_CPU is not set
# CONFIG_CC_PIC is not set
CONFIG_CC_STACKPROTECTOR_NONE=y
CONFIG_CC_STRIP=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_LOGGING is not set
# CONFIG_TRACE is not set
# CONFIG_MEASURE is not set
