# Profile: embedded — smallest possible binary for a fixed, known CPU.
#
# Size-optimized, acceleration fixed at build time (no runtime dispatch
# tables), stripped, all debug/log/trace facilities compiled out.
# Apply on top of a defconfig: make defconfig embedded.config
CONFIG_CC_OPTIMIZE=y
# CONFIG_CC_OPTIMIZE_FOR_SPEED is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_CPU_ACCEL_RUNTIME is not set
CONFIG_CC_CPU_ACCEL_BUILDTIME=y
# CONFIG_GENERIC_CPU is not set
CONFIG_MATOM=y
# CONFIG_CC_PIC is not set
CONFIG_CC_STRIP=y
CONFIG_CC_STDLIB=n
CONFIG_CC_CLIB=n
CONFIG_CC_STACKPROTECTOR_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_LOGGING is not set
# CONFIG_TRACE is not set
# CONFIG_MEASURE is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_MEMORY_HOTREMOVE is not set
# CONFIG_HOTPLUG_CPU is not set
