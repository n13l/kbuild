# Profile: compat — maximum compatibility: one binary that runs correctly
# on any x86-64 CPU.
#
# Generic processor family, acceleration selected by runtime CPU detection
# (CPUID), position-independent code and strong stack protector so the
# result is safe to ship as a distro package or shared library.
# Apply on top of a defconfig: make defconfig compat.config
CONFIG_CC_OPTIMIZE=y
CONFIG_CC_OPTIMIZE_FOR_SPEED=y
CONFIG_GENERIC_CPU=y
CONFIG_CC_CPU_ACCEL_RUNTIME=y
CONFIG_CC_PIC=y
# CONFIG_CC_STACKPROTECTOR_NONE is not set
CONFIG_CC_STACKPROTECTOR_STRONG=y
# CONFIG_CC_STRIP is not set
CONFIG_DEBUG_INFO=y
CONFIG_LOGGING=y
