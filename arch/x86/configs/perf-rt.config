# Profile: perf-rt — low-latency / real-time variant of perf.
#
# Same build-time CPU tuning as perf, plus the lock-free runtime
# facilities: RCU read-side data structures (linear read scaling, no
# read-side locks) and restartable sequences (per-CPU data access without
# atomics). CPU hotplug is disabled — RT deployments pin threads to
# isolated cores with a fixed topology.
# Apply on top of a defconfig: make defconfig perf-rt.config
CONFIG_CC_OPTIMIZE=y
CONFIG_CC_OPTIMIZE_FOR_SPEED=y
# CONFIG_CC_CPU_ACCEL_RUNTIME is not set
CONFIG_CC_CPU_ACCEL_BUILDTIME=y
# CONFIG_GENERIC_CPU is not set
CONFIG_MHASWELL=y
CONFIG_CC_RCU=y
CONFIG_CC_RSEQ=y
# CONFIG_CC_PIC is not set
CONFIG_CC_STACKPROTECTOR_NONE=y
CONFIG_CC_STRIP=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_LOGGING is not set
# CONFIG_TRACE is not set
# CONFIG_HOTPLUG_CPU is not set
