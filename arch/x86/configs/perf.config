# Profile: perf — maximum throughput on a fixed modern CPU.
#
# Speed-optimized, acceleration fixed at build time to the configured
# processor family (no runtime dispatch indirection), no PIC, no stack
# protector, no debug/log/trace overhead. The binary requires a CPU at
# least as capable as the selected family. MHASWELL ~ x86-64-v3 (AVX2);
# bump to MSKYLAKEX / MZEN3 for AVX-512 machines.
# Apply on top of a defconfig: make defconfig perf.config
CONFIG_CC_OPTIMIZE=y
CONFIG_CC_OPTIMIZE_FOR_SPEED=y
# CONFIG_CC_CPU_ACCEL_RUNTIME is not set
CONFIG_CC_CPU_ACCEL_BUILDTIME=y
# CONFIG_GENERIC_CPU is not set
CONFIG_MHASWELL=y
# CONFIG_CC_PIC is not set
CONFIG_CC_STACKPROTECTOR_NONE=y
CONFIG_CC_STRIP=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_LOGGING is not set
# CONFIG_TRACE is not set
# CONFIG_MEASURE is not set
